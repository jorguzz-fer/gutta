# Copie para .env e preencha. Nunca commite o .env.

# Endereço público do app (sem barra no fim)
APP_URL=http://localhost:3000

# Banco. A aplicação conecta com o papel gutta_app (sem BYPASSRLS).
DATABASE_URL=postgres://gutta_app:gutta_app_dev@localhost:5432/gutta
# Migrations e seeds usam o dono do schema.
DATABASE_OWNER_URL=postgres://gutta_owner:gutta_owner_dev@localhost:5432/gutta

# Better Auth: gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# E-mail transacional. Sem RESEND_API_KEY, os e-mails são só registrados no log (desenvolvimento).
RESEND_API_KEY=
MAIL_FROM="Cognuss <nao-responda@gutta.tudomudou.com.br>"

# Origens permitidas no player de aula interativa (iframe), separadas por espaço
LESSON_ORIGINS="https://aula.alumine.com.br https://lab.tudomudou.com.br"

# E-mails (separados por vírgula) que viram admin no start, com o e-mail já confirmado.
# A conta precisa existir (cadastro feito). Não cria usuário nem senha. Opcional.
BOOTSTRAP_ADMIN_EMAILS=

# "demo" carrega no start o catálogo e o conteúdo de demonstração (com selo), sem usuários.
# Vazio: não carrega nada. Ver ADR 0005.
SEED_CATALOG=

# Senha dos usuários de demonstração criados pelo seed (só desenvolvimento e testes)
SEED_PASSWORD=gutta-demo-2026

# IA: tutor (ADR 0008, web) e leitura de cronograma (SPEC v2, DIS-05, worker). Sem chave, os
# dois aparecem indisponíveis para os alunos.
ANTHROPIC_API_KEY=
# anthropic (padrão) ou fake (respostas fixas, para testes sem chave; recusado em produção
# pelo worker)
AI_PROVIDER=anthropic
# Modelo e esforço da leitura de cronograma (worker)
AI_SCHEDULE_MODEL=claude-opus-5-5
AI_SCHEDULE_EFFORT=medium
# Criações da Ajuda Cognuss (ADR 0020).
AI_CREATION_MODEL=claude-opus-5-5
AI_CREATION_EFFORT=medium
TUTOR_MODEL=claude-opus-5-5
# Busca por conceito (ADR 0014): Voyage AI, no web (buscas) e no worker (vetores dos materiais).
# Sem chave, só a busca por palavra. No painel da Voyage, deixe "Opted Out" (retenção zero).
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
# Perguntas por aluno em 24 horas (o admin muda em /admin/tutor)
TUTOR_DAILY_LIMIT=20

# LGPD: controlador e encarregado (art. 41). Aparecem na política e em /app/privacidade.
# Sem valor, as páginas mostram "a definir". Preencha com os dados reais antes do piloto.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_DOCUMENT=
DPO_NAME=
DPO_EMAIL=

# Redis (ADR 0013): fila de trabalhos e limite de taxa do login compartilhado entre réplicas.
# Sem ele, o app funciona com o limite em memória e os eventos esperam no outbox.
REDIS_URL=redis://localhost:6379
# Prefixo das chaves da fila no Redis (separa ambientes no mesmo servidor).
QUEUE_PREFIX=cognuss

# Armazenamento de arquivos no Cloudflare R2 (ADR 0012), pela API compatível com S3.
# Arquivo real de aluno só depois do parecer jurídico sobre a transferência (SPEC v2, D06).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Só em desenvolvimento e testes: STORAGE_DRIVER=memory (memória do processo) ou fs (disco, com
# envio pelo navegador por URL assinada que aponta para /api/dev-storage). Com fs, defina a pasta
# e um segredo qualquer; o web e o worker precisam apontar para a mesma pasta.
STORAGE_DRIVER=fs
STORAGE_FS_DIR=/tmp/cognuss-arquivos
STORAGE_FS_SECRET=troque-em-desenvolvimento

# Antivírus do worker: "clamd" (padrão, obrigatório em produção) ou "none" (desenvolvimento).
SCANNER=none
CLAMD_HOST=localhost
CLAMD_PORT=3310

# Módulos da v2 ligados sem passar pelo admin (/admin/funcionalidades): lista separada por
# vírgula ou "all". Use em desenvolvimento e no E2E; em produção, deixe vazio.
FEATURES_ON=

# Dado pessoal cifrado (CPF do cadastro; SPEC v2, CAD-10). Gere cada uma com
# `openssl rand -base64 32`. Guarde as duas no cofre: sem a de cifra, o CPF salvo não volta a
# ser lido; trocar a de resumo quebra a regra de um CPF por conta.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
